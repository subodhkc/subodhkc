# Resend API Key (for contact form emails)
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Site URL (for metadata and SEO)
NEXT_PUBLIC_SITE_URL=https://subodhkc.com

# ============================================
# SUPABASE (Database & Auth)
# ============================================
# Get these from: Supabase Dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://shnbyttoswxhfnurdnxo.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_DB_URL=postgresql://postgres:your-password@db.shnbyttoswxhfnurdnxo.supabase.co:5432/postgres
# Auth: Google OAuth + Magic Links
# 1. Enable email auth: Supabase Dashboard > Authentication > Providers > Email
# 2. Enable Google OAuth: Supabase Dashboard > Authentication > Providers > Google
#    - Add Google OAuth credentials from Google Cloud Console
#    - Set redirect URL to: https://shnbyttoswxhfnurdnxo.supabase.co/auth/v1/callback
# 3. For local dev, also set redirect URL in Google Console to localhost:3000

# Analytics API token (protects /api/analytics and /api/outreach-tracker)
ANALYTICS_API_TOKEN=your-analytics-token

# BabyLoveGrowth API Key (for blog article sync)
# Get from Settings → Integrations → API in BabyLoveGrowth dashboard
BABYLOVE_API_KEY=your-blg-api-key-here

# BabyLoveGrowth Sync Secret (protects /api/blog-sync endpoint)
BABYLOVE_SYNC_SECRET=your-sync-secret-here

# Google Indexing API (for on-demand URL indexing)
# Get these from your GCP service account JSON key file
INDEXING_SERVICE_ACCOUNT_EMAIL=your-sa@your-project.iam.gserviceaccount.com
INDEXING_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Bearer token to protect /api/index-url endpoint (prevents quota exhaustion)
# Generate with: openssl rand -hex 32
INDEXING_API_TOKEN=your-secret-token-here

# LinkedIn OAuth (for auto-posting blog articles to LinkedIn)
# Get these from: https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
# Access token obtained via OAuth flow — expires in ~60 days
# For CI: store as GitHub secret LINKEDIN_ACCESS_TOKEN
LINKEDIN_ACCESS_TOKEN=
# LinkedIn member ID (your profile ID, needed for posting)
LINKEDIN_MEMBER_ID=

# ============================================
# STRIPE PRICE IDS (Commercial Offers)
# ============================================
# AI Advisor for Business ($99/mo, $990/yr)
STRIPE_PRICE_AI_ADVISOR_DESK_MONTHLY=price_xxx
STRIPE_PRICE_AI_ADVISOR_DESK_ANNUAL=price_xxx
# AI Automation Blueprint ($500 one-time)
STRIPE_PRICE_AI_AUTOMATION_BLUEPRINT_ONE_TIME=price_xxx
# Fractional AI Advisor ($1,250/mo, $12,500/yr)
STRIPE_PRICE_FRACTIONAL_AI_ADVISOR_MONTHLY=price_xxx
STRIPE_PRICE_FRACTIONAL_AI_ADVISOR_ANNUAL=price_xxx
# Stripe webhook secret
STRIPE_WEBHOOK_SECRET=whsec_xxx
